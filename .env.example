# Optional Docker Compose overrides. The checked-in defaults are for local use only.
POSTGRES_DB=project_management
POSTGRES_USER=project_app
POSTGRES_PASSWORD=project_dev_password
JWT_SECRET=replace-with-at-least-32-random-characters
MINIO_ROOT_USER=project_minio_admin
MINIO_ROOT_PASSWORD=project_minio_password
S3_BUCKET=project-platform

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional AI project generation
OPENAI_API_KEY=
PROJECT_AI_MODEL=gpt-5.5
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=

# Optional integration settings: copy the desired keys from backend/.env.example.
